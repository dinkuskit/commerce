  {
    "type": "header",
    "text": "Merchant store settings"
  },
  {
    "type": "context",
    "text": "Checkout refuses a physical delivery outside your shipping destinations."
  },
  {
    "type": "context",
    "text": "Choose your store country. On the first country save, blank destinations default to that country. Extra destinations must be added explicitly. You can save the phone setting before choosing a country."
  },
  {
    "type": "form",
    "block_id": "merchant-store-settings:null",
    "fields": [
      {
        "type": "text_input",
