      {
        "type": "toggle",
        "action_id": "requirePhoneNumber",
        "label": "Require a phone number",
        "description": "Require customers to include a phone number at checkout.",
        "initial_value": false
      }
    ],
    "submit": {
      "label": "Save merchant settings",
      "action_id": "merchant-store-settings.save"
