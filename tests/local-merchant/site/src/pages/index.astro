---
const response = await fetch(Astro.url.origin + '/_emdash/api/plugins/dinkus-commerce/catalog/public');
const json = await response.json();
const products = (json.data ?? json).products ?? [];
---
<!doctype html><html lang="en"><head><title>Local fixture store</title></head><body>
<h1>Local fixture store</h1><p>Synthetic Payments service. No Stripe charge, shipment, PDF or email.</p>
<label>Product <select id="product">{products.map(p => <option value={p.id ?? p.catalogItemId}>{p.name}</option>)}</select></label>
<label>Email <input id="email" type="email" /></label>
<fieldset><legend>Delivery address</legend>
<label>Recipient <input id="recipient" /></label><label>Address line 1 <input id="line1" /></label>
<label>City <input id="city" /></label><label>State or region <input id="region" /></label><label>Postal code <input id="postal" /></label><label>Country <input id="country" /></label>
</fieldset>
<button id="prepare">Prepare checkout</button><button id="start" disabled>Start checkout</button>
<button id="pay" disabled>Simulate provider payment</button><button id="status" disabled>Refresh payment status</button>
<p id="state">Not prepared</p>
<script is:inline>
let capability, attempt;
const state = document.querySelector('#state');
async function call(name, data) {
  const r = await fetch('/_emdash/api/plugins/dinkus-commerce/checkout/guest/' + name, {
    method: 'POST', headers: { 'content-type': 'application/json', ...(capability ? { 'x-commerce-guest-capability': capability } : {}) }, body: JSON.stringify(data) });
  const b = await r.json(); const result = b.data ?? b;
  if (!result.ok) { state.textContent = result.error?.code ?? 'failed'; throw new Error('Checkout refused'); }
  return result;
}
document.querySelector('#prepare').onclick = async () => { const b = await call('prepare', {}); capability = b.capability.capability; state.textContent = 'Prepared'; document.querySelector('#start').disabled = false; };
document.querySelector('#start').onclick = async () => { const delivery = { name: document.querySelector('#recipient').value, line1: document.querySelector('#line1').value,
    city: document.querySelector('#city').value, region: document.querySelector('#region').value, postalCode: document.querySelector('#postal').value, country: document.querySelector('#country').value };
  // Billing same as delivery: the fixture store sends a full copy.
  const b = await call('start', { contact: { email: document.querySelector('#email').value, delivery, billing: { ...delivery } },
  lines: [{ catalogItemId: document.querySelector('#product').value, quantity: 1 }] });
  attempt = b.checkout.attemptId; state.textContent = 'Payment pending'; document.querySelector('#pay').disabled = false; document.querySelector('#status').disabled = false; };
document.querySelector('#pay').onclick = async () => { await fetch('/fixture?action=pay', { method: 'POST' }); state.textContent = 'Fixture provider paid; Commerce pending'; };
document.querySelector('#status').onclick = async () => { const b = await call('status', { attemptId: attempt }); state.textContent = b.checkout.state; };
</script></body></html>
