{
  "name": "@dinkuskit/commerce",
  "version": "0.0.0",
  "description": "The open-source commerce layer for EmDash sites",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "emdash-plugin.jsonc"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./features/catalog": {
      "types": "./dist/features/catalog/index.d.ts",
      "default": "./dist/features/catalog/index.js"
    },
    "./features/catalog/browser": {
      "types": "./dist/features/catalog/browser/index.d.ts",
      "default": "./dist/features/catalog/browser/index.js"
    },
    "./features/inventory-provider": {
      "types": "./dist/features/inventory-provider/index.d.ts",
      "default": "./dist/features/inventory-provider/index.js"
    },
    "./features/inventory-setup": {
      "types": "./dist/features/inventory-setup/index.d.ts",
      "default": "./dist/features/inventory-setup/index.js"
    },
    "./features/storefront-availability": {
      "types": "./dist/features/storefront-availability/index.d.ts",
      "default": "./dist/features/storefront-availability/index.js"
    },
    "./features/storefront-availability/browser": {
      "types": "./dist/features/storefront-availability/browser/index.d.ts",
      "default": "./dist/features/storefront-availability/browser/index.js"
    },
    "./admin": {
      "types": "./dist/admin/native.d.ts",
      "default": "./dist/admin/native.js"
    },
    "./sandbox": "./dist/sandbox/plugin.mjs",
    "./descriptor": "./dist/sandbox/index.mjs",
    "./features/checkout": {
      "types": "./dist/features/checkout/index.d.ts",
      "default": "./dist/features/checkout/index.js"
    },
    "./features/fixed-bundles": {
      "types": "./dist/features/fixed-bundles/index.d.ts",
      "default": "./dist/features/fixed-bundles/index.js"
    },
    "./features/coupons": {
      "types": "./dist/features/coupons/index.d.ts",
      "default": "./dist/features/coupons/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/commerce.git"
  },
  "dinkuskit": {
    "emdashCompatibility": {
      "apiPeer": "1.2.0",
      "nodeEngine": ">=22.16.0 <23",
      "packageIntegrity": "sha512-f9s7khWeuOxX5cRimlu9o224hn9TuKnYk/0Vsu1CS9oaVn78V1+MWyfEsZc2iDv8JYWrezEZFkpy/Q6pRgVgzg==",
      "mountedSitePilot": "private",
      "requiredSourceVisibility": "public",
      "requiredSourceRepository": "https://github.com/emdash-cms/emdash",
      "stockReleaseBehavior": "fail-closed",
      "stableReleaseExit": "repin-and-rerun-compatibility-proof"
    },
    "pendingComposition": {
      "checkout": {
        "pullRequest": "https://github.com/dinkuskit/commerce/pull/29",
        "status": "mounted-public-routes-synthetic-unverified-stripe",
        "preserveExports": [
          "./admin",
          "./descriptor",
          "./sandbox",
          "./features/checkout"
        ],
        "preserveChecks": [
          "build:sandbox",
          "tests/features/checkout/*.test.mjs"
        ],
        "decisionLineage": "Issue32 mounts public guest prepare/start/status and checkoutCarts on native and Registry/sandbox. Prepare mints a server capability before any payment or hold. Default Payments adapter remains unavailable. Synthetic fixture injection proves transport. Actual Stripe is not run. Registry cannot invoke a Payments plugin."
      }
    }
  },
  "peerDependencies": {
    "emdash": "1.2.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:sandbox",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test tests/*.test.mjs tests/workflows/*.test.mjs tests/features/catalog/*.test.mjs tests/features/inventory-provider/*.test.mjs tests/features/inventory-setup/*.test.mjs tests/features/storefront-availability/*.test.mjs tests/features/checkout/*.test.mjs tests/features/fixed-bundles/*.test.mjs tests/features/coupons/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "proof:registration-retry:real": "npm run build && node --no-warnings --experimental-sqlite --experimental-strip-types tools/prove-registration-retry-real.mjs",
    "audit:features": "node scripts/check-features.mjs",
    "audit:repo": "node scripts/repo-contract.mjs && npm run audit:features",
    "verify:quick": "bin/verify-commerce quick",
    "verify:full": "bin/verify-commerce full",
    "build:sandbox": "emdash-plugin validate && node scripts/build-sandbox.mjs && node scripts/check-registry-bundle.mjs",
    "test:sandbox": "playwright test",
    "test:sandbox:native-local-stock": "playwright test --config=playwright.native-local-stock.config.mjs",
    "test:sandbox:orders": "playwright test --config=tests/orders-blocks.playwright.config.mjs"
  },
  "devDependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@emdash-cms/auth": "1.2.0",
    "@emdash-cms/blocks": "1.2.0",
    "@emdash-cms/plugin-cli": "0.13.3",
    "@emdash-cms/plugin-types": "0.6.0",
    "@emdash-cms/sandbox-workerd": "0.9.3",
    "@playwright/test": "1.61.1",
    "@types/react": "19.3.0",
    "astro": "7.1.3",
    "better-sqlite3": "12.11.1",
    "emdash": "1.2.0",
    "kysely": "0.29.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.127.0",
    "@lingui/core": "5.9.5",
    "@lingui/message-utils": "5.9.5",
    "rolldown": "1.2.6"
  }
}
