{
  "name": "@dinkuskit/commerce",
  "version": "0.0.0",
  "description": "The open-source commerce layer for EmDash sites",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./features/catalog": {
      "types": "./dist/features/catalog/index.d.ts",
      "default": "./dist/features/catalog/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/commerce.git"
  },
  "peerDependencies": {
    "emdash": "0.35.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test tests/*.test.mjs tests/workflows/*.test.mjs tests/features/catalog/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "audit:features": "node scripts/check-features.mjs",
    "audit:repo": "node scripts/repo-contract.mjs && npm run audit:features",
    "verify:quick": "bin/verify-commerce quick",
    "verify:full": "bin/verify-commerce full"
  },
  "devDependencies": {
    "better-sqlite3": "12.11.1",
    "emdash": "0.35.0",
    "kysely": "0.29.5",
    "typescript": "6.0.3",
    "wrangler": "4.127.0"
  }
}
