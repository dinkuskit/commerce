{
  "name": "@dinkuskit/commerce",
  "version": "0.0.0",
  "description": "The open-source commerce layer for EmDash sites",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "emdash-plugin.jsonc"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./features/catalog": {
      "types": "./dist/features/catalog/index.d.ts",
      "default": "./dist/features/catalog/index.js"
    },
    "./features/catalog/browser": {
      "types": "./dist/features/catalog/browser/index.d.ts",
      "default": "./dist/features/catalog/browser/index.js"
    },
    "./features/inventory-provider": {
      "types": "./dist/features/inventory-provider/index.d.ts",
      "default": "./dist/features/inventory-provider/index.js"
    },
    "./features/inventory-setup": {
      "types": "./dist/features/inventory-setup/index.d.ts",
      "default": "./dist/features/inventory-setup/index.js"
    },
    "./features/storefront-availability": {
      "types": "./dist/features/storefront-availability/index.d.ts",
      "default": "./dist/features/storefront-availability/index.js"
    },
    "./features/storefront-availability/browser": {
      "types": "./dist/features/storefront-availability/browser/index.d.ts",
      "default": "./dist/features/storefront-availability/browser/index.js"
    },
    "./admin": {
      "types": "./dist/admin/native.d.ts",
      "default": "./dist/admin/native.js"
    },
    "./sandbox": "./dist/sandbox/plugin.mjs",
    "./descriptor": "./dist/sandbox/index.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/commerce.git"
  },
  "dinkuskit": {
    "emdashCompatibility": {
      "apiPeer": "0.41.0",
      "mountedSitePilot": "private",
      "requiredSourceVisibility": "public",
      "requiredSourceRepository": "https://github.com/saariuslystoned/emdash",
      "requiredCommit": "4c1f21900f3a28e9a270e64111f4979bce74926e",
      "upstreamPullRequest": "https://github.com/emdash-cms/emdash/pull/2768",
      "stockReleaseBehavior": "fail-closed",
      "stableReleaseExit": "repin-and-rerun-smokyclub-proof"
    }
  },
  "peerDependencies": {
    "emdash": "0.41.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:sandbox",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test tests/*.test.mjs tests/workflows/*.test.mjs tests/features/catalog/*.test.mjs tests/features/inventory-provider/*.test.mjs tests/features/inventory-setup/*.test.mjs tests/features/storefront-availability/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "proof:registration-retry:real": "npm run build && node --no-warnings --experimental-sqlite --experimental-strip-types tools/prove-registration-retry-real.mjs",
    "audit:features": "node scripts/check-features.mjs",
    "audit:repo": "node scripts/repo-contract.mjs && npm run audit:features",
    "verify:quick": "bin/verify-commerce quick",
    "verify:full": "bin/verify-commerce full",
    "build:sandbox": "emdash-plugin validate && emdash-plugin build --out-dir dist/sandbox",
    "test:sandbox": "playwright test"
  },
  "devDependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@emdash-cms/blocks": "0.41.0",
    "@emdash-cms/plugin-cli": "0.12.0",
    "@emdash-cms/sandbox-workerd": "0.8.2",
    "@playwright/test": "1.61.1",
    "@types/react": "19.3.0",
    "astro": "7.1.3",
    "better-sqlite3": "12.11.1",
    "emdash": "0.41.0",
    "kysely": "0.29.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.127.0"
  }
}
