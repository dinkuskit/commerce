{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-commerce",
  "version": "0.1.0",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "Commerce",
  "description": "Manage products, prices and catalog settings in EmDash.",
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://github.com/dinkuskit"
  },
  "security": {
    "url": "https://github.com/dinkuskit/commerce/security"
  },
  "repo": "https://github.com/dinkuskit/commerce",
  "capabilities": [
    "media:read",
    "network:request"
  ],
  "allowedHosts": [
    "payments.dinkuskit.com",
    "coupons.dinkuskit.com",
    "ship.dinkuskit.com",
    "dinkuskit.com"
  ],
  "storage": {
    "catalog_items": {
      "indexes": [],
      "uniqueIndexes": [
        "commandId",
        "skuKey"
      ]
    },
    "catalog_backorder_policies": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_manual_availability": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_prices": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "product_feed_eligibility": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_media": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "managed_sku_claims": {
      "indexes": [
        "catalogItemId"
      ],
      "uniqueIndexes": [
        "claimKey",
        "operationId"
      ]
    },
    "store_inventory_configurations": {
      "indexes": [],
      "uniqueIndexes": [
        "configurationKey"
      ]
    },
    "storefront_availability_settings": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "storefront_out_of_stock_listing": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "storefront_placeholder_image": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_carts": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_guest_capabilities": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_payment_associations": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "orders": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "order_numbers": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "store_shipping_policy": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "store_return_policy": {
      "indexes": [],
      "uniqueIndexes": []
    }
  },
  "admin": {
    "settingsSchema": {
      "installedCheckout": {
        "type": "string",
        "label": "Checkout settings",
        "description": "Paste from the Set up Commerce box on DinkusKit.com. Empty or switched off keeps checkout unavailable."
      },
      "storeKey": {
        "type": "secret",
        "label": "Store key",
        "description": "Paste from the Set up Commerce box on DinkusKit.com. Commerce trades it there for short passes to Payments and Ship; Replace key on DinkusKit.com stops this one."
      }
    },
    "pages": [
      { "path": "/orders", "label": "Commerce Orders", "icon": "storefront" },
      {
        "path": "/products",
        "label": "Commerce Products",
        "icon": "storefront"
      },
      {
        "path": "/settings",
        "label": "Commerce Settings",
        "icon": "settings"
      }
    ]
  }
}
