{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-commerce",
  "version": "0.8.0",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "DinkusKit Commerce",
  "description": "Manage products, prices and orders in EmDash. Connect DinkusKit Payments for checkout and Ship for shipping-label workflows.",
  "keywords": ["ecommerce", "products", "checkout", "orders", "catalog"],
  "sections": {
    "description": { "file": "./docs/registry/description.md" },
    "installation": { "file": "./docs/registry/installation.md" },
    "faq": { "file": "./docs/registry/faq.md" },
    "changelog": { "file": "./docs/registry/changelog.md" }
  },
  "release": {
    "artifacts": {
      "icon": { "file": "./assets/listing/icon.webp" },
      "screenshots": [
        { "file": "./assets/listing/product-panel.png", "lang": "en" },
        { "file": "./assets/listing/commerce-settings.png", "lang": "en" }
      ]
    }
  },
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://dinkuskit.com"
  },
  "security": {
    "url": "https://github.com/dinkuskit/commerce/security"
  },
  "repo": "https://github.com/dinkuskit/commerce",
  "capabilities": [
    "content:read",
    "hooks.content-policy:register",
    "hooks.email-events:register",
    "media:read",
    "network:request",
    "admin.editor-draft:read",
    "admin.editor-draft:patch"
  ],
  "allowedHosts": [
    "payments.dinkuskit.com",
    "ship.dinkuskit.com",
    "dinkuskit.com",
    "catalog.dinkuskit.com"
  ],
  "storage": {
    "catalog_items": {
      "indexes": [
        "deleting"
      ],
      "uniqueIndexes": [
        "commandId",
        "skuKey"
      ]
    },
    "catalog_backorder_policies": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_manual_availability": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_prices": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "product_feed_eligibility": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_media": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "managed_sku_claims": {
      "indexes": [
        "catalogItemId"
      ],
      "uniqueIndexes": [
        "claimKey",
        "operationId"
      ]
    },
    "store_inventory_configurations": {
      "indexes": [],
      "uniqueIndexes": [
        "configurationKey"
      ]
    },
    "storefront_availability_settings": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "storefront_out_of_stock_listing": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "storefront_placeholder_image": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_carts": {
      "indexes": ["cartExpires", "remindAt", "leftKey"],
      "uniqueIndexes": []
    },
    "checkout_guest_capabilities": {
      "indexes": ["expiresAt"],
      "uniqueIndexes": []
    },
    "checkout_payment_associations": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "cart_email_stops": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_readiness": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "orders": {
      "indexes": [
        "emailKey",
        "shippedKey",
        "paidKey"
      ],
      "uniqueIndexes": []
    },
    "order_numbers": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "order_lookup_guesses": {
      "indexes": [
        "expiresAt"
      ],
      "uniqueIndexes": []
    },
    "scheduled_sales": {
      "indexes": ["page", "go"],
      "uniqueIndexes": []
    },
    "product_pages": {
      "indexes": [
        "entryId"
      ],
      "uniqueIndexes": []
    }
  },
  "admin": {
    "settingsSchema": {
      "connection": {
        "type": "secret",
        "label": "DinkusKit connection",
        "description": "Encrypted Store ID and this plugin's own DinkusKit store key. Managed by Connect on Commerce Settings; don't change it here."
      }
    },
    "pages": [
      { "path": "/orders", "label": "Orders", "icon": "storefront", "group": "Store" },
      {
        "path": "/settings",
        "label": "Commerce settings",
        "icon": "settings",
        "group": "Store"
      }
    ],
    "editorPanels": [
      {
        "id": "product",
        "title": "Dinkus Commerce",
        "route": "product-panel",
        "collections": ["products"],
        "draft": {
          "read": { "fields": ["title"] }
        }
      },
      {
        "id": "product-media",
        "title": "Product image & gallery",
        "route": "product-media-panel",
        "collections": ["products"]
      },
      {
        "id": "product-category",
        "title": "Product category",
        "route": "product-category-panel",
        "collections": ["products"],
        "draft": {
          "read": { "fields": ["title", "description", "product_category"] },
          "patch": { "fields": ["product_category"] }
        }
      }
    ]
  }
}
