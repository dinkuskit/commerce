{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-commerce",
  "version": "0.5.0",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "Commerce",
  "description": "Manage products, prices and catalog settings in EmDash.",
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://github.com/dinkuskit"
  },
  "security": {
    "url": "https://github.com/dinkuskit/commerce/security"
  },
  "repo": "https://github.com/dinkuskit/commerce",
  "capabilities": [
    "media:read",
    "network:request",
    "email:send",
    "admin.editor-draft:read",
    "admin.editor-draft:patch"
  ],
  "allowedHosts": [
    "payments.dinkuskit.com",
    "coupons.dinkuskit.com",
    "ship.dinkuskit.com",
    "dinkuskit.com"
  ],
  "storage": {
    "catalog_items": {
      "indexes": [],
      "uniqueIndexes": [
        "commandId",
        "skuKey"
      ]
    },
    "catalog_backorder_policies": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_manual_availability": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_prices": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "product_feed_eligibility": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "catalog_media": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "managed_sku_claims": {
      "indexes": [
        "catalogItemId"
      ],
      "uniqueIndexes": [
        "claimKey",
        "operationId"
      ]
    },
    "store_inventory_configurations": {
      "indexes": [],
      "uniqueIndexes": [
        "configurationKey"
      ]
    },
    "storefront_availability_settings": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "storefront_out_of_stock_listing": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "storefront_placeholder_image": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_carts": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_guest_capabilities": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_payment_associations": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "checkout_readiness": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "orders": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "order_numbers": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "store_shipping_policy": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "store_return_policy": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "customers": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "customer_login_codes": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "customer_sessions": {
      "indexes": [],
      "uniqueIndexes": []
    },
    "product_pages": {
      "indexes": [
        "entryId"
      ],
      "uniqueIndexes": []
    }
  },
  "admin": {
    "settingsSchema": {
      "connection": {
        "type": "secret",
        "label": "DinkusKit connection",
        "description": "Encrypted Store ID and this plugin's own DinkusKit store key. Managed by Connect on Commerce Settings; don't change it here."
      }
    },
    "pages": [
      { "path": "/orders", "label": "Orders", "icon": "storefront", "group": "Dinkus Commerce" },
      {
        "path": "/settings",
        "label": "Commerce settings",
        "icon": "settings",
        "group": "Dinkus Commerce"
      }
    ],
    "editorPanels": [
      {
        "id": "product",
        "title": "Dinkus Commerce",
        "route": "product-panel",
        "collections": ["products"],
        "draft": {
          "read": { "fields": ["title", "commerce_item_id"] },
          "patch": { "fields": ["commerce_item_id"] }
        }
      }
    ]
  }
}
