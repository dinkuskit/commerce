#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
cd "$repo_root"

mode="${1:-quick}"

case "$mode" in
  quick)
    npm run typecheck
    npm run test:unit
    npm run audit:repo
    ;;
  core)
    "$script_dir/verify-commerce" quick
    npm run test:integration
    npm run test:sandbox
    npm run test:sandbox:native-local-stock
    npm run test:sandbox:orders
    ;;
  full)
    "$script_dir/verify-commerce" core
    npm run test:settings
    ;;
  *)
    echo "Usage: bin/verify-commerce [quick|core|full]" >&2
    exit 64
    ;;
esac

printf "verify-commerce: %s passed\n" "$mode"
